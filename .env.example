# Careerloom Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Project & API
PROJECT_NAME="Careerloom"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security (Change SECRET_KEY in production!)
SECRET_KEY="careerloom-production-change-this-secret-key-32bytes-min"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default: Local SQLite database
DATABASE_URL="sqlite+aiosqlite:///./careerloom.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://careerloom:careerloom_pass@localhost:5432/careerloom_db"

# Storage Configuration
STORAGE_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=15

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# LLM Provider Configuration (Optional - Local deterministic fallbacks active by default)
OPENAI_API_KEY=""
LLM_PROVIDER="local_heuristic"  # Options: local_heuristic, openai
